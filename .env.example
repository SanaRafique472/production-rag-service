# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
# true = offline fake providers (tests/demo only, answers are NOT real). Keep false for real use.
USE_FAKE_PROVIDERS=false

# --- Auth (generate with: openssl rand -hex 32) ---
JWT_SECRET_KEY=change-me
JWT_EXPIRE_MINUTES=60

# --- Databases ---
# The values below need Docker (docker compose up -d postgres qdrant).
# WITHOUT Docker: make DATABASE_URL= and QDRANT_URL= empty; data then goes to a local SQLite
# file and the QDRANT_PATH folder below, and is kept after a restart.
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
QDRANT_URL=http://localhost:6333
QDRANT_PATH=./qdrant_storage
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks

# --- Model providers ---
# Only COHERE_API_KEY is required: one free trial key runs everything
# (embeddings, rerank, answers with Command A+, and the evaluation judge).
# Get it at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# Which model writes the answers: cohere (free Command A+) or anthropic (Claude, paid).
LLM_PROVIDER=cohere
# Evaluation judge: cohere (free, same key) or openai (needs OPENAI_API_KEY).
JUDGE_PROVIDER=cohere
# Optional, only for LLM_PROVIDER=anthropic / JUDGE_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Models (defaults shown; change only if you know why) ---
EMBED_MODEL_INDEX=embed-v5.0-pro
EMBED_MODEL_QUERY=embed-v5.0-fast
RERANK_MODEL=rerank-v5.0-fast
COHERE_LLM_MODEL=command-a-plus-05-2026
COHERE_JUDGE_MODEL=command-a-03-2025
LLM_MODEL=claude-haiku-5-5
JUDGE_MODEL=gpt-6-luna

# --- Rate limits (per user, or per IP before login) ---
RATE_LIMIT_ASK=20/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_AUTH=10/minute
